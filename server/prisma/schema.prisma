datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  SELLER
  AFFILIATE
  ADMIN
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  REVERSED
}

enum WalletTransactionType {
  COMMISSION_CREDIT
  PAYOUT_HOLD
  PAYOUT_RELEASE
  PAYOUT_DEBIT
  REFUND_REVERSAL
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id               String               @id @default(uuid()) @db.Uuid
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?
  avatarUrl        String?
  isActive         Boolean              @default(true)
  refreshTokenHash String?

  roles            UserRoleAssignment[]
  shopMemberships  ShopMember[]
  affiliateProfile AffiliateProfile?
  carts            Cart[]
  orders           Order[]
  behaviorLogs     UserBehaviorLog[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([isActive, createdAt])
  @@map("users")
}

model UserRoleAssignment {
  userId    String   @db.Uuid
  role      UserRole
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_role_assignments")
}

model Shop {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  description String?      @db.Text
  logoUrl     String?
  status      ShopStatus   @default(PENDING)

  members     ShopMember[]
  products    Product[]
  shopOrders  ShopOrder[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("shops")
}

model ShopMember {
  id        String         @id @default(uuid()) @db.Uuid
  shopId    String         @db.Uuid
  userId    String         @db.Uuid
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId, role])
  @@map("shop_members")
}

// B. DANH MỤC, SẢN PHẨM, GIỎ HÀNG

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?
  parentId    String?    @db.Uuid

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @db.Uuid
  categoryId     String        @db.Uuid
  name           String
  slug           String
  description    String?       @db.Text
  images         String[]      @default([])
  status         ProductStatus @default(DRAFT)

  // null = dùng mức mặc định của sàn
  commissionRate Decimal?      @db.Decimal(5, 4)

  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skus           ProductSku[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Slug có thể trùng giữa hai shop, nhưng không trùng trong cùng shop.
  @@unique([shopId, slug])
  @@index([shopId, status, createdAt])
  @@index([categoryId, status])
  @@map("products")
}

model ProductSku {
  id         String          @id @default(uuid()) @db.Uuid
  productId  String          @db.Uuid
  skuCode    String          @unique
  price      Decimal         @db.Decimal(12, 2)
  stock      Int             @default(0)
  attributes Json            @default("{}")
  isActive   Boolean         @default(true)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems ShopOrderItem[]

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([productId, isActive])
  @@map("product_skus")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String     @id @default(uuid()) @db.Uuid
  cartId    String     @db.Uuid
  skuId     String     @db.Uuid
  quantity  Int        @default(1)

  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([cartId, skuId])
  @@index([skuId])
  @@map("cart_items")
}

// C. ĐƠN HÀNG, ĐƠN CON, THANH TOÁN

model Order {
  id                    String                @id @default(uuid()) @db.Uuid
  orderCode             String                @unique
  userId                String                @db.Uuid

  // Affiliate đã được chốt tại thời điểm checkout.
  affiliateId           String?               @db.Uuid
  affiliateCodeSnapshot String?

  recipientName         String
  recipientPhone        String
  shippingAddress       String                @db.Text

  subtotalAmount        Decimal               @db.Decimal(12, 2)
  discountAmount        Decimal               @default(0) @db.Decimal(12, 2)
  shippingAmount        Decimal               @default(0) @db.Decimal(12, 2)
  finalAmount           Decimal               @db.Decimal(12, 2)

  status                OrderStatus           @default(PENDING)
  paymentStatus         PaymentStatus         @default(UNPAID)
  paymentMethod         String                @default("COD")

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  affiliate             AffiliateProfile?     @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  shopOrders            ShopOrder[]
  paymentTransactions   PaymentTransaction[]
  commission            AffiliateCommission?
  statusHistory         OrderStatusHistory[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([affiliateId, createdAt])
  @@map("orders")
}

model ShopOrder {
  id             String                   @id @default(uuid()) @db.Uuid
  orderId        String                   @db.Uuid
  shopId         String                   @db.Uuid
  shopOrderCode  String                   @unique

  subtotalAmount Decimal                  @db.Decimal(12, 2)
  discountAmount Decimal                  @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal                  @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal                  @db.Decimal(12, 2)

  status         ShopOrderStatus          @default(PENDING)
  items          ShopOrderItem[]
  statusHistory  ShopOrderStatusHistory[]

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shop           Shop                     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Một đơn tổng chỉ có một đơn con cho mỗi shop.
  @@unique([orderId, shopId])
  @@index([shopId, status, createdAt])
  @@index([orderId, status])
  @@map("shop_orders")
}

model ShopOrderItem {
  id              String     @id @default(uuid()) @db.Uuid
  shopOrderId     String     @db.Uuid
  skuId           String     @db.Uuid

  // Snapshot lịch sử tại thời điểm checkout.
  productName     String
  skuCodeSnapshot String
  skuAttributes   Json
  unitPrice       Decimal    @db.Decimal(12, 2)
  quantity        Int
  subtotal        Decimal    @db.Decimal(12, 2)

  shopOrder       ShopOrder  @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  sku             ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt       DateTime   @default(now())

  @@index([shopOrderId])
  @@index([skuId])
  @@map("shop_order_items")
}

model PaymentTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  orderId        String                   @db.Uuid
  provider       String
  providerTxnId  String?                  @unique
  idempotencyKey String                   @unique
  amount         Decimal                  @db.Decimal(12, 2)
  status         PaymentTransactionStatus @default(PENDING)
  failureReason  String?
  paidAt         DateTime?

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([orderId, status])
  @@index([provider, createdAt])
  @@map("payment_transactions")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  changedBy String?     @db.Uuid
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model ShopOrderStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  shopOrderId String          @db.Uuid
  status      ShopOrderStatus
  note        String?
  changedBy   String?         @db.Uuid
  createdAt   DateTime        @default(now())

  shopOrder   ShopOrder       @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)

  @@index([shopOrderId, createdAt])
  @@map("shop_order_status_history")
}

// D. AFFILIATE

model AffiliateProfile {
  id                 String                       @id @default(uuid()) @db.Uuid
  userId             String                       @unique @db.Uuid
  referralCode       String                       @unique

  // Số dư khả dụng và số dư đang chờ đối soát.
  // Đây là số dư tổng hợp, không phải sổ giao dịch.
  balance            Decimal                      @default(0) @db.Decimal(14, 2)
  pendingBalance     Decimal                      @default(0) @db.Decimal(14, 2)

  bankName           String?
  bankAccount        String?
  bankOwner          String?

  user               User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  referredOrders     Order[]
  commissions        AffiliateCommission[]
  walletTransactions AffiliateWalletTransaction[]
  payoutRequests     PayoutRequest[]
  clicks             AffiliateClick[]

  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@map("affiliate_profiles")
}

model AffiliateCommission {
  id               String           @id @default(uuid()) @db.Uuid
  affiliateId      String           @db.Uuid
  orderId          String           @unique @db.Uuid

  // Snapshot của cơ sở tính hoa hồng và tỷ lệ lúc chốt.
  eligibleAmount   Decimal          @db.Decimal(12, 2)
  commissionRate   Decimal          @db.Decimal(5, 4)
  commissionAmount Decimal          @db.Decimal(12, 2)

  status           CommissionStatus @default(PENDING)
  settledAt        DateTime?
  rejectionReason  String?

  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([affiliateId, status, createdAt])
  @@index([status, createdAt])
  @@map("affiliate_commissions")
}

model AffiliateWalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  affiliateId    String                @db.Uuid
  type           WalletTransactionType

  // Quy ước: tiền cộng dương, tiền trừ âm.
  amount         Decimal               @db.Decimal(14, 2)
  referenceType  String?
  referenceId    String?
  idempotencyKey String                @unique
  description    String?

  affiliate      AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  createdAt      DateTime              @default(now())

  @@index([affiliateId, createdAt])
  @@index([affiliateId, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("affiliate_wallet_transactions")
}

model PayoutRequest {
  id          String           @id @default(uuid()) @db.Uuid
  affiliateId String           @db.Uuid
  amount      Decimal          @db.Decimal(14, 2)
  status      PayoutStatus     @default(PENDING)

  // Snapshot thông tin nhận tiền, tránh thay đổi khi affiliate sửa hồ sơ.
  bankName    String
  bankAccount String
  bankOwner   String

  note        String?
  processedBy String?          @db.Uuid
  processedAt DateTime?

  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([affiliateId, status, createdAt])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model AffiliateClick {
  id          String           @id @default(uuid()) @db.Uuid
  affiliateId String           @db.Uuid
  sessionId   String?
  targetUrl   String
  referrerUrl String?
  userAgent   String?
  ipHash      String?

  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  createdAt   DateTime         @default(now())

  @@index([affiliateId, createdAt])
  @@index([sessionId, createdAt])
  @@map("affiliate_clicks")
}

// E. AI Analytics

enum BehaviorEventType {
  VIEW_PRODUCT
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_STARTED
  PURCHASE
  VIEW_CATEGORY
  CLICK_RECOMMENDATION
}

model UserBehaviorLog {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @db.Uuid
  sessionId String
  eventType BehaviorEventType
  metadata  Json              @default("{}")

  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@map("user_behavior_logs")
}
