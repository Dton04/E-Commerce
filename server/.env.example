# Database connection (PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000

# JWT Security Configuration
# CRITICAL: Secrets MUST be at least 32 characters long.
# The application will FAIL TO START if secrets are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="replace-with-a-cryptographically-secure-access-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-cryptographically-secure-refresh-secret-at-least-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
